#!/usr/bin/env bash
# yt-playlist-downloader — sync YouTube playlists to local audio files
#
# USAGE
#   yt-playlist-downloader [OPTIONS] [ROOT_DIR]
#
# OPTIONS
#   -f, --file FILE    playlist file to read URLs from (default: see CONFIG FILE)
#   -u, --url URL      sync a single playlist URL (overrides --file)
#       --no-confirm   skip the pre-download summary and confirmation prompt
#   -c, --cookies-from-browser BROWSER
#                      use your browser's YouTube login (firefox, chrome, chromium,
#                      brave, vivaldi, …). Needed for private playlists and
#                      "confirm you're not a bot" errors. For a Firefox-based browser
#                      (Waterfox, LibreWolf, …) pass its profile: firefox:/path/to/profile
#                      Default: $YT_PLAYLIST_DOWNLOADER_BROWSER
#   -h, --help         show this help
#
# CONFIG FILE
#   If neither --file nor --url is given, the script looks for a playlist file at:
#     $XDG_CONFIG_HOME/yt-playlist-downloader/playlists.conf   (usually ~/.config/yt-playlist-downloader/playlists.conf)
#   One URL per line. Lines starting with # and blank lines are ignored.
#
# FILE LAYOUT (inside ROOT_DIR, default: ~/Music, or Android shared storage under Termux)
#   ROOT_DIR/
#     <Playlist Title>/
#       001 - Track Title [videoID].ogg
#       002 - Another Track [videoID].ogg
#     .archive          ← yt-dlp download archive (do not delete)
#     .lock             ← removed after each run
#
# REQUIREMENTS
#   yt-dlp   https://github.com/yt-dlp/yt-dlp
#   ffmpeg   (for audio conversion)

set -euo pipefail

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

WARNINGS=()

die()  { echo "ERROR: $*" >&2; exit 1; }
warn() { echo "WARNING: $*" >&2; WARNINGS+=("$*"); }
info() { echo ">>> $*"; }

# Run yt-dlp, retrying when YouTube randomly refuses a playlist page (HTTP 403).
# Usage: yt_retry OUTFILE ARGS…   (OUTFILE "-" = terminal). Stderr goes to $ERR_FILE.
yt_retry() {
    local out="$1" attempt step="fetching playlist info"; shift
    [[ "$out" == - ]] && step="downloading"
    for attempt in 1 2 3; do
        if [[ "$out" == - ]]; then
            yt-dlp "${YTDLP_ARGS[@]}" "$@" 2> "$ERR_FILE"
        else
            yt-dlp "${YTDLP_ARGS[@]}" "$@" > "$out" 2> "$ERR_FILE"
        fi && return 0
        grep -q "Unable to download API page" "$ERR_FILE" || return 1
        [[ $attempt -lt 3 ]] && {
            info "YouTube refused the request while $step for ${*: -1} (attempt $attempt/3): $(grep -m1 -o 'HTTP Error [0-9]*: [A-Za-z ]*[A-Za-z]' "$ERR_FILE")"
            # 403s here are rate limiting; a short pause doesn't clear it
            info "Retrying in $((attempt * 30))s…"
            sleep $((attempt * 30))
        }
    done
    return 1
}

usage() {
    sed -n '/^# USAGE/,/^# REQUIREMENTS/{ /^# REQUIREMENTS/d; s/^# \{0,1\}//; p }' "$0"
    exit 0
}

# ---------------------------------------------------------------------------
# Dependency check
# ---------------------------------------------------------------------------

check_deps() {
    local missing=()
    for cmd in yt-dlp ffmpeg; do
        command -v "$cmd" &>/dev/null || missing+=("$cmd")
    done
    if [[ ${#missing[@]} -gt 0 ]]; then
        die "Missing required tools: ${missing[*]}
  Arch/CachyOS:   sudo pacman -S yt-dlp ffmpeg
  Debian/Ubuntu:  sudo apt install ffmpeg && pipx install yt-dlp   (apt's yt-dlp is often outdated)
  Fedora:         sudo dnf install yt-dlp ffmpeg
  macOS:          brew install yt-dlp ffmpeg
  Termux:         pkg install python ffmpeg && pip install -U yt-dlp"
    fi
}

# ---------------------------------------------------------------------------
# Argument parsing
# ---------------------------------------------------------------------------

PLAYLIST_FILE=""
SINGLE_URL=""
ROOT=""
NO_CONFIRM=0
COOKIES_BROWSER="${YT_PLAYLIST_DOWNLOADER_BROWSER:-}"

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)       usage ;;
        -f|--file)       PLAYLIST_FILE="${2:?--file requires a path}"; shift 2 ;;
        -u|--url)        SINGLE_URL="${2:?--url requires a URL}";      shift 2 ;;
        -c|--cookies-from-browser) COOKIES_BROWSER="${2:?--cookies-from-browser requires a browser name}"; shift 2 ;;
        --no-confirm)    NO_CONFIRM=1; shift ;;
        -*)              die "Unknown option: $1 (try --help)" ;;
        *)               ROOT="$1"; shift ;;
    esac
done

# Extra args passed to every yt-dlp call. Spacing requests out avoids YouTube's rate limit (HTTP 403).
YTDLP_ARGS=(--sleep-requests 1)
[[ -n "$COOKIES_BROWSER" ]] && YTDLP_ARGS+=(--cookies-from-browser "$COOKIES_BROWSER")

# -- Android/Termux detection --
# Under Termux, $HOME is Termux's private sandbox (/data/data/com.termux/files/home),
# not real phone storage. If the person hasn't set up ~/storage (via
# termux-setup-storage) yet, default there anyway and fail with a clear message
# rather than silently writing files Termux can see but no other app can.
IS_TERMUX=0
[[ -n "${TERMUX_VERSION:-}" ]] && IS_TERMUX=1

if [[ -z "$ROOT" ]]; then
    if [[ $IS_TERMUX -eq 1 ]]; then
        ROOT="$HOME/storage/shared/Music"
    else
        ROOT="$HOME/Music"
    fi
fi

if [[ $IS_TERMUX -eq 1 && ! -d "$HOME/storage/shared" ]]; then
    die "Termux shared storage isn't set up yet.
  Run: termux-setup-storage
  (then grant the storage permission Android asks for) and re-run this script."
fi

XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
DEFAULT_CONF="$XDG_CONFIG_HOME/yt-playlist-downloader/playlists.conf"

# -- Non-interactive detection --
# When triggered headlessly (e.g. via MacroDroid -> Termux RUN_COMMAND, or any
# cron/CI context), there is no controlling terminal, so the "Proceed? [y/N]"
# prompt below would block forever on a read from /dev/tty that never resolves.
# Auto-enable --no-confirm in that case instead of hanging.
if [[ $NO_CONFIRM -eq 0 && ! -e /dev/tty ]]; then
    info "No controlling terminal detected (non-interactive run) — skipping confirmation prompt automatically."
    NO_CONFIRM=1
fi

# ---------------------------------------------------------------------------
# Load playlist URLs
# ---------------------------------------------------------------------------

PLAYLIST_URLS=()

if [[ -n "$SINGLE_URL" ]]; then
    PLAYLIST_URLS=("$SINGLE_URL")

elif [[ -n "$PLAYLIST_FILE" ]]; then
    [[ -f "$PLAYLIST_FILE" ]] || die "Playlist file not found: $PLAYLIST_FILE"

else
    # Fall back to default config
    if [[ ! -f "$DEFAULT_CONF" ]]; then
        die "No playlist source given and no default config found at $DEFAULT_CONF
  Create it with one YouTube playlist URL per line, or use:
    $0 --url URL
    $0 --file /path/to/playlists.conf"
    fi
    PLAYLIST_FILE="$DEFAULT_CONF"
    info "Using config: $PLAYLIST_FILE"
fi

if [[ -n "$PLAYLIST_FILE" ]]; then
    while IFS= read -r line || [[ -n "$line" ]]; do
        # strip leading/trailing whitespace
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"
        [[ -z "$line" || "$line" == \#* ]] && continue
        [[ " ${PLAYLIST_URLS[*]} " == *" $line "* ]] && continue   # skip duplicates
        PLAYLIST_URLS+=("$line")
    done < "$PLAYLIST_FILE"
    [[ ${#PLAYLIST_URLS[@]} -gt 0 ]] || die "No playlist URLs found in '$PLAYLIST_FILE'."
fi

# ---------------------------------------------------------------------------
# Setup
# ---------------------------------------------------------------------------

check_deps

mkdir -p "$ROOT" || die "Cannot create root directory: $ROOT"

ARCHIVE="$ROOT/.archive"
LOCKFILE="$ROOT/.lock"

# Prevent concurrent runs against the same ROOT
if ! ( set -o noclobber; echo "$$" > "$LOCKFILE" ) 2>/dev/null; then
    existing_pid=$(<"$LOCKFILE")
    die "Another instance (PID $existing_pid) is already running against $ROOT.
  If that's wrong, delete $LOCKFILE and retry."
fi
trap 'rm -f "$LOCKFILE"' EXIT

# Temp dir — avoid shadowing the system TMPDIR variable
WORK_DIR="$(mktemp -d)"
ERR_FILE="$WORK_DIR/err.txt"
trap 'rm -rf "$WORK_DIR"; rm -f "$LOCKFILE"' EXIT

# -- Keep the CPU awake for the duration of the run under Termux --
# Android aggressively suspends background processes; termux-wake-lock (from
# the termux-api package) prevents the CPU from sleeping mid-download.
if [[ $IS_TERMUX -eq 1 ]] && command -v termux-wake-lock &>/dev/null; then
    termux-wake-lock
    trap 'rm -rf "$WORK_DIR"; rm -f "$LOCKFILE"; termux-wake-unlock' EXIT
fi

# ---------------------------------------------------------------------------
# Pre-flight: fetch metadata for all playlists, print summary, confirm
# ---------------------------------------------------------------------------
# We do this before any downloading so the user sees the full picture upfront.
# Each playlist's ID list is cached in WORK_DIR and reused in the sync loop
# below — no double network call.

declare -A PLAYLIST_ID_FILES   # URL -> path to cached IDs file
declare -A PLAYLIST_TRACK_COUNTS
declare -A PLAYLIST_TITLES     # URL -> folder name, sanitized exactly as yt-dlp names it
VALID_URLS=()

echo ""
echo "Fetching playlist info…"

for PLAYLIST_URL in "${PLAYLIST_URLS[@]}"; do
    CURRENT_IDS="$WORK_DIR/ids_$(printf '%s' "$PLAYLIST_URL" | md5sum | cut -c1-8).txt"
    PLAYLIST_ID_FILES["$PLAYLIST_URL"]="$CURRENT_IDS"

    # "--print filename" yields "<sanitized title>/<id>" per entry, so we get the
    # folder name even when every track is already archived (nothing downloads).
    if ! yt_retry "$WORK_DIR/entries.txt" \
            --flat-playlist \
            --print filename \
            --output "%(playlist_title)s/%(id)s" \
            --no-warnings \
            "$PLAYLIST_URL"; then
        hint=""
        [[ -z "$COOKIES_BROWSER" ]] && grep -qE 'Sign in|private' "$ERR_FILE" \
            && hint=" (try --cookies-from-browser firefox)"
        warn "Could not fetch $PLAYLIST_URL: $(grep -m1 ERROR "$ERR_FILE" || tail -1 "$ERR_FILE")$hint"
        continue
    fi

    if [[ ! -s "$WORK_DIR/entries.txt" ]]; then
        warn "Playlist appears empty or inaccessible: $PLAYLIST_URL — skipping."
        continue
    fi

    sed 's|.*/||' "$WORK_DIR/entries.txt" > "$CURRENT_IDS"
    PLAYLIST_TITLES["$PLAYLIST_URL"]="$(head -1 "$WORK_DIR/entries.txt" | sed 's|/[^/]*$||')"
    PLAYLIST_TRACK_COUNTS["$PLAYLIST_URL"]=$(wc -l < "$CURRENT_IDS" | tr -d ' ')
    VALID_URLS+=("$PLAYLIST_URL")
done

if [[ ${#VALID_URLS[@]} -eq 0 ]]; then
    die "No reachable playlists to sync."
fi

# -- Print summary --
echo ""
echo "========================================"
echo " Sync summary"
echo "========================================"
echo " Destination : $ROOT"
echo " Archive     : $ROOT/.archive"
echo " Cookies     : ${COOKIES_BROWSER:-none}"
echo " Playlists   : ${#VALID_URLS[@]}"
echo ""
for PLAYLIST_URL in "${VALID_URLS[@]}"; do
    count="${PLAYLIST_TRACK_COUNTS[$PLAYLIST_URL]}"
    printf '  [%3d tracks]  %s\n' "$count" "$PLAYLIST_URL"
done
echo ""
echo " Tracks already in the archive will be skipped."
echo " Tracks removed from a playlist will be deleted locally."
echo "========================================"

# -- Confirm unless --no-confirm was passed (or auto-detected above) --
if [[ $NO_CONFIRM -eq 0 ]]; then
    printf '\nProceed? [y/N] '
    read -r answer </dev/tty
    case "$answer" in
        [yY]|[yY][eE][sS]) : ;;
        *) echo "Aborted."; exit 0 ;;
    esac
fi

echo ""

# ---------------------------------------------------------------------------
# Process each playlist
# ---------------------------------------------------------------------------


for PLAYLIST_URL in "${VALID_URLS[@]}"; do
    echo ""
    echo "========================================"
    info "Syncing: $PLAYLIST_URL"
    echo "========================================"

    CURRENT_IDS="${PLAYLIST_ID_FILES[$PLAYLIST_URL]}"

    info "Found ${PLAYLIST_TRACK_COUNTS[$PLAYLIST_URL]} tracks in playlist."

    # -- Download / update --
    # Errors on individual videos are tolerated (--ignore-errors); overall
    # yt-dlp failure (e.g. network gone) is caught by the exit-code check.
    if ! yt_retry - \
            --extract-audio \
            --audio-format vorbis \
            --audio-quality 0 \
            --format "ba[acodec=opus]/ba[ext=m4a]/ba" \
            --embed-metadata \
            --embed-thumbnail \
            --parse-metadata "playlist:%(playlist_title)s:%(album)s" \
            --download-archive "$ARCHIVE" \
            --ignore-errors \
            --continue \
            --concurrent-fragments 4 \
            --trim-filenames 180 \
            --no-warnings \
            --output "$ROOT/%(playlist_title)s/%(playlist_index)03d - %(title)s [%(id)s].%(ext)s" \
            "$PLAYLIST_URL"; then
        cat "$ERR_FILE" >&2
        warn "yt-dlp reported errors for $PLAYLIST_URL (some tracks may have been skipped)."
        # Don't skip deletion step — partial sync is still a valid sync
    fi

    PLAYLIST_TITLE="${PLAYLIST_TITLES[$PLAYLIST_URL]}"

    if [[ -z "$PLAYLIST_TITLE" ]]; then
        warn "Could not determine playlist title — skipping deletion step for $PLAYLIST_URL."
        continue
    fi

    PLAYLIST_DIR="$ROOT/$PLAYLIST_TITLE"
    info "Playlist folder: $PLAYLIST_DIR"

    # -- Remove tracks that are no longer in the playlist --
    if [[ -d "$PLAYLIST_DIR" ]]; then
        info "Checking for removed tracks…"
        removed=0
        while IFS= read -r -d '' file; do
            filename="$(basename "$file")"
            # Extract the [videoID] portion — robust to brackets in the title
            # because yt-dlp always appends [id] right before the extension.
            id="${filename%\.*}"          # strip extension
            id="${id##*\[}"              # take everything after the last [
            id="${id%\]}"                # strip trailing ]

            if [[ -z "$id" ]]; then
                warn "Could not parse ID from filename: $filename"
                continue
            fi

            if ! grep -qxF "$id" "$CURRENT_IDS"; then
                info "Removing: $file"
                rm -f "$file"
                # Forget it in the archive too, so re-adding it later downloads it again
                grep -vxF "youtube $id" "$ARCHIVE" > "$WORK_DIR/archive.tmp" || true
                cat "$WORK_DIR/archive.tmp" > "$ARCHIVE"
                (( removed++ )) || true
            fi
        done < <(find "$PLAYLIST_DIR" -type f \( -name "*.ogg" -o -name "*.m4a" \) -print0)

        [[ $removed -gt 0 ]] && info "Removed $removed track(s)." || info "No tracks to remove."
    fi

    info "Done: $PLAYLIST_URL"
done

echo ""
echo "========================================"
if [[ ${#WARNINGS[@]} -eq 0 ]]; then
    echo " All playlists synced successfully."
else
    echo " Sync complete — ${#WARNINGS[@]} warning(s):"
    echo ""
    for w in "${WARNINGS[@]}"; do
        printf "  !  %s\n" "$w"
    done
fi
echo "========================================"

[[ ${#WARNINGS[@]} -eq 0 ]] || exit 1